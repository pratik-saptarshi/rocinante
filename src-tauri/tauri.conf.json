{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rocinante Repo Analyzer",
  "version": "0.1.0",
  "identifier": "com.rocinante.repoanalyzer",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm --dir ui install --frozen-lockfile && pnpm --dir ui run build && python3 scripts/provision_duckdb.py --stage-runtime-for-tauri-bundle",
    "beforeBundleCommand": "python3 scripts/prepare-tauri-duckdb-bundle.py"
  },
  "app": {
    "windows": [
      {
        "title": "Rocinante Repo Analyzer",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "icon": [
      "crates/rocinante-desktop-shell/packaging/icons/rocinante.png",
      "crates/rocinante-desktop-shell/packaging/icons/Rocinante.icns",
      "crates/rocinante-desktop-shell/packaging/icons/Rocinante.ico"
    ],
    "resources": {
      "tauri-resources/": ""
    }
  }
}
